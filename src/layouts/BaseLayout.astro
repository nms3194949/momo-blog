---
import '../styles/global.css';
import { SITE, AUTHOR, LINKS, ANALYTICS } from '../site.config';
import { url, absUrl } from '../lib/posts';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';

interface Props {
  title: string;
  description: string;
  /** 分享縮圖（絕對網址） */
  image?: string;
  type?: 'website' | 'article';
  /** 額外的 JSON-LD 結構化資料 */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  jsonLd = [],
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title === SITE.name ? title : `${title}｜${SITE.name}`;
const ogImage = image ?? absUrl('/og-default.png');

// 每一頁都帶的網站與作者資料
const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absUrl('/#website'),
    name: SITE.name,
    url: absUrl('/'),
    inLanguage: SITE.lang,
    description: SITE.description,
    publisher: { '@id': absUrl('/about/#person') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': absUrl('/about/#person'),
    name: AUTHOR.name,
    alternateName: AUTHOR.alternateName,
    jobTitle: AUTHOR.jobTitle,
    worksFor: AUTHOR.worksFor ? { '@type': 'Organization', name: AUTHOR.worksFor } : undefined,
    description: AUTHOR.bio,
    disambiguatingDescription: AUTHOR.disambiguation,
    brand: { '@type': 'Brand', name: SITE.name },
    url: absUrl('/about/'),
    image: absUrl(AUTHOR.avatar),
    hasCredential: AUTHOR.credentials.length
      ? AUTHOR.credentials.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: c }))
      : undefined,
    knowsAbout: ['資產配置', '配息基金', '保單基金規劃', '基金投資', '退休現金流規劃'],
    sameAs: [LINKS.instagram, LINKS.threads].filter((u) => !u.includes('REPLACE_ME')),
  },
];
const allLd = [...baseLd, ...jsonLd];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={AUTHOR.name} />
    <meta name="theme-color" content="#f6f1e7" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={url('/llms.txt')} />

    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    {
      ANALYTICS.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`} />
          <script is:inline define:vars={{ gaId: ANALYTICS.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
            // 追蹤導流點擊：LINE、IG、Threads
            document.addEventListener('click', function (e) {
              var a = e.target.closest && e.target.closest('a[href]');
              if (!a) return;
              var h = a.href;
              var dest = h.indexOf('lin.ee') > -1 || h.indexOf('line.me') > -1 ? 'line'
                : h.indexOf('instagram.com') > -1 ? 'instagram'
                : h.indexOf('threads.net') > -1 ? 'threads' : '';
              if (!dest) return;
              var box = a.closest('.cta-box, .sticky-bar, .site-footer, .hero');
              var where = !box ? 'other' : box.classList.contains('sticky-bar') ? 'sticky' : box.classList.contains('site-footer') ? 'footer' : box.classList.contains('hero') ? 'hero' : 'cta';
              gtag('event', dest + '_click', { link_location: where, page_path: location.pathname });
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url('/')}>
          <img class="brand-mark" src={url('/icon-96.png')} alt="" width="32" height="32" />
          <span class="brand-name">{SITE.name}</span>
        </a>
        <nav class="nav">
          <a href={url('/')}>文章</a>
          <a href={url('/tags/')}>主題</a>
          <a href={url('/tools/retirement/')}>試算</a>
          <a href={url('/about/')}>關於</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />
    <StickyBar />
  </body>
</html>
