---
// 理財百科目錄頁：依分類列出所有已發布的百科文章
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDE_CATEGORIES } from '../../content.config';
import { SITE } from '../../site.config';
import { getPublishedGuides, url, absUrl, guidePath, formatDate } from '../../lib/posts';

const guides = await getPublishedGuides();
const groups = GUIDE_CATEGORIES.map((c) => ({ c, items: guides.filter((g) => g.data.category === c) })).filter(
  (x) => x.items.length > 0,
);

const pageUrl = absUrl('/guide/');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#collection`,
    name: `理財百科｜${SITE.name}`,
    url: pageUrl,
    inLanguage: SITE.lang,
    isPartOf: { '@id': absUrl('/#website') },
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: absUrl(guidePath(g)) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: '理財百科', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="理財百科"
  description="用白話解釋基金、配息、債券與資產配置的常見名詞和問題：配息率、存續期間、殖利率、定期定額……每篇先給答案，再用例子說明。"
  jsonLd={jsonLd}
>
  <section class="wrap">
    <nav class="breadcrumb" aria-label="麵包屑" style="margin-top:20px">
      <a href={url('/')}>首頁</a><span>/</span><span>理財百科</span>
    </nav>
    <h1 class="page-title" style="margin-top:12px">理財百科</h1>
    <p class="muted" style="margin-top:-6px">
      基金、配息、債券與資產配置的常見名詞和問題，每篇先給一句話答案，再用例子說明。
    </p>

    {guides.length === 0 && <p>第一篇即將上架。</p>}

    {
      groups.map(({ c, items }) => (
        <section class="guide-group">
          <h2 class="section-title">{c}</h2>
          <ul class="guide-list">
            {items.map((g) => (
              <li>
                <a href={url(guidePath(g))}>
                  <span class="guide-q">{g.data.title}</span>
                  <span class="guide-a">{g.data.description}</span>
                  <time datetime={g.data.date.toISOString()}>{formatDate(g.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>
