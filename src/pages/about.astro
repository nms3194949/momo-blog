---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBox from '../components/CtaBox.astro';
import { AUTHOR, AUTHOR_TAGLINE, SITE } from '../site.config';
import { url, absUrl } from '../lib/posts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: absUrl('/about/'),
    mainEntity: { '@id': absUrl('/about/#person') },
  },
];
---

<BaseLayout title={`關於 ${AUTHOR.name}`} description={AUTHOR.bio} jsonLd={jsonLd}>
  <article class="wrap article">
    <header class="about-head">
      <img src={url(AUTHOR.avatar)} alt={AUTHOR.name} width="96" height="96" />
      <div>
        <h1>{AUTHOR.name}</h1>
        <p class="muted">{AUTHOR_TAGLINE}</p>
      </div>
    </header>

    <div class="prose">
      <p>{AUTHOR.bio}</p>

      {AUTHOR.credentials.length > 0 && (
        <>
          <h2>專業資格</h2>
          <ul>
            {AUTHOR.credentials.map((c) => <li>{c}</li>)}
          </ul>
        </>
      )}

      <h2>我在這裡寫什麼</h2>
      <p>
        {SITE.name} 收錄我在 Instagram 發布的每一篇圖卡，並補上完整文字、數據來源與常見問題，主題圍繞資產配置、配息現金流與市場判讀。
      </p>

      <h2>我的核心觀念</h2>
      <ul>
        <li><strong>真實報酬 = 配息 + 淨值變化</strong>：只看配息率，會忽略本金正在被吃掉的風險。</li>
        <li><strong>核心衛星配置</strong>：核心部位負責穩定現金流，衛星部位負責成長。</li>
        <li><strong>動態再平衡</strong>：依市場位置與資金水位調整，而不是預測漲跌。</li>
      </ul>
    </div>

    <CtaBox campaign="about" variant="profile" />
  </article>
</BaseLayout>
