---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBox from '../../components/CtaBox.astro';
import { SITE } from '../../site.config';
import { absUrl } from '../../lib/posts';

// ── 試算假設（依規定，假設報酬率最高以 6% 揭露）──
const RATE = 0.06; // 年化報酬率假設，會顯示在頁面上
const INFLATION = 0.02; // 通膨假設，用於「實際購買力」
const DEFAULT_RETIRE = 60;
const DEFAULT_TARGET = 1000; // 萬元

const r = RATE / 12;
const pmt = (age: number, retire = DEFAULT_RETIRE, targetWan = DEFAULT_TARGET) => {
  const n = (retire - age) * 12;
  const g = Math.pow(1 + r, n);
  return (targetWan * 10000 * r) / (g - 1);
};
const fmt = (n: number) => Math.round(n).toLocaleString('zh-TW');

// 建置時先算好範例表（給搜尋引擎與 AI 引用）
const examples = [25, 30, 35, 40, 45, 50].map((age) => {
  const m = pmt(age);
  const principal = (m * (DEFAULT_RETIRE - age) * 12) / 10000;
  return { age, monthly: Math.ceil(m / 100) * 100, principal: Math.round(principal) };
});
const ex30 = examples.find((e) => e.age === 30)!;
const ex40 = examples.find((e) => e.age === 40)!;

const pageTitle = '退休存 1000 萬，每月要存多少？定期定額試算';
const pageDesc = `輸入年齡、退休年齡與目標金額，試算每月定期定額要投入多少。以年化報酬率 ${RATE * 100}% 假設計算，並顯示晚幾年開始，每月要多存多少。`;

const faq = [
  {
    q: '想在 60 歲存到 1000 萬，每月要存多少？',
    a: `以年化報酬率 ${RATE * 100}% 試算，30 歲開始每月約需投入 ${fmt(ex30.monthly)} 元，40 歲開始則約需 ${fmt(ex40.monthly)} 元。越早開始，每月負擔越輕。`,
  },
  {
    q: '晚幾年開始存，差別有多大？',
    a: `差別很大。以目標 1000 萬、60 歲退休為例，30 歲開始每月約 ${fmt(ex30.monthly)} 元，晚 10 年到 40 歲才開始，每月約需 ${fmt(ex40.monthly)} 元，是原本的兩倍以上。因為晚開始，複利累積的時間就少了。`,
  },
  {
    q: '為什麼用 6% 試算？',
    a: '6% 是試算用的假設值，用來估算長期定期定額的累積效果，不代表任何商品的實際或保證報酬。實際報酬會因市場、商品、費用而不同，也可能虧損。',
  },
  {
    q: '30 年後的 1000 萬，等於現在多少錢？',
    a: `若以每年通膨 ${INFLATION * 100}% 估算，30 年後的 1000 萬，購買力約等於現在的 ${fmt(1000 / Math.pow(1 + INFLATION, 30))} 萬元。設定退休目標時，可以把通膨一起考慮進去。`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '定期定額退休試算',
    url: absUrl('/tools/retirement/'),
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    inLanguage: 'zh-Hant-TW',
    description: pageDesc,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'TWD' },
    author: { '@id': absUrl('/about/#person') },
    isPartOf: { '@id': absUrl('/#website') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <article class="wrap article calc-page">
    <header class="article-header">
      <p class="eyebrow">MOMO 工具｜定期定額試算</p>
      <h1>退休存 1000 萬，<br />每月要存多少？</h1>
      <p class="muted">輸入你的年齡，30 秒算出每月需要投入的金額，以及「晚開始」要付出的代價。</p>
    </header>

    <section class="calc" data-calc data-rate={RATE} data-inflation={INFLATION}>
      <div class="calc-fields">
        <label>
          <span>目前年齡</span>
          <div class="field"><input type="number" inputmode="numeric" name="age" value="30" min="18" max="70" /><em>歲</em></div>
        </label>
        <label>
          <span>預計退休年齡</span>
          <div class="field"><input type="number" inputmode="numeric" name="retire" value={DEFAULT_RETIRE} min="30" max="80" /><em>歲</em></div>
        </label>
        <label>
          <span>退休目標資產</span>
          <div class="field"><input type="number" inputmode="numeric" name="target" value={DEFAULT_TARGET} min="10" step="50" /><em>萬</em></div>
        </label>
        <label>
          <span>目前已準備（選填）</span>
          <div class="field"><input type="number" inputmode="numeric" name="saved" value="0" min="0" step="10" /><em>萬</em></div>
        </label>
      </div>

      <div class="calc-result" aria-live="polite">
        <p class="res-label">從現在開始，每月需投入</p>
        <p class="res-main"><span data-out="monthly">—</span><small> 元</small></p>
        <p class="res-sub" data-out="summary"></p>
        <div class="res-split">
          <div><span>你投入的本金</span><strong data-out="principal">—</strong></div>
          <div><span>複利幫你累積</span><strong data-out="growth">—</strong></div>
        </div>
      </div>

      <div class="delay">
        <p class="delay-title">⏳ 每晚一年開始，代價有多大？</p>
        <div class="delay-rows" data-out="delay"></div>
        <p class="delay-note" data-out="delaynote"></p>
      </div>

      <div class="infl">
        <p data-out="inflation"></p>
      </div>

      <p class="assume">
        試算假設：年化報酬率 {RATE * 100}%、每月月底投入、按月複利；未計入費用、稅負與匯率。此為假設情境試算，不代表任何商品之實際或保證報酬，投資有賺有賠。
      </p>
    </section>

    <CtaBox campaign="tool-retirement" variant="profile" />

    <div class="prose">
      <h2>不同年齡開始，每月要存多少？</h2>
      <p>以「60 歲退休、目標 1000 萬、年化報酬率 {RATE * 100}%」試算：</p>
      <table>
        <thead><tr><th>開始年齡</th><th>每月需投入</th><th>總投入本金</th></tr></thead>
        <tbody>
          {examples.map((e) => (
            <tr><td>{e.age} 歲</td><td>約 {fmt(e.monthly)} 元</td><td>約 {e.principal} 萬</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        30 歲開始，每月約 {fmt(ex30.monthly)} 元；拖到 40 歲才開始，每月要 {fmt(ex40.monthly)} 元，<strong>是兩倍以上</strong>。差距來自複利的時間：越早開始，本金越少，複利幫你賺的越多。
      </p>

      <h2>怎麼算的？</h2>
      <p>
        這個試算用的是定期定額的終值公式：每月固定投入一筆錢，按月複利累積到退休那年，回推需要的每月金額。如果你已經有一筆準備金，會先計算它到退休時的價值，再扣掉後回推。
      </p>
      <blockquote>
        試算只是起點。真正要考慮的，還有這筆錢放在哪裡、能不能承受過程中的波動，以及退休後的現金流怎麼安排。
      </blockquote>
    </div>

    <section class="faq">
      <h2>常見問題</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </article>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const RATE = Number(root.dataset.rate);
    const INFL = Number(root.dataset.inflation);
    const r = RATE / 12;
    const $ = (n: string) => root.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
    const out = (n: string) => root.querySelector<HTMLElement>(`[data-out="${n}"]`)!;
    const fmt = (n: number) => Math.round(n).toLocaleString('zh-TW');
    const wan = (n: number) => (n >= 10000 ? `${fmt(n / 10000)} 萬` : `${fmt(n)} 元`);
    const roundUp = (n: number) => Math.ceil(n / 100) * 100;

    const need = (age: number, retire: number, target: number, saved: number) => {
      const n = (retire - age) * 12;
      if (n <= 0) return null;
      const g = Math.pow(1 + r, n);
      const left = target - saved * g;
      if (left <= 0) return 0;
      return (left * r) / (g - 1);
    };

    const calc = () => {
      const age = Number($('age').value);
      const retire = Number($('retire').value);
      const target = Number($('target').value) * 10000;
      const saved = Math.max(0, Number($('saved').value) || 0) * 10000;
      const years = retire - age;

      if (!age || !retire || !target || years <= 0) {
        out('monthly').textContent = '—';
        out('summary').textContent = '退休年齡需大於目前年齡。';
        out('principal').textContent = out('growth').textContent = '—';
        out('delay').innerHTML = '';
        out('delaynote').textContent = out('inflation').textContent = '';
        return;
      }

      const m = need(age, retire, target, saved)!;
      if (m === 0) {
        out('monthly').textContent = '0';
        out('summary').textContent = `以 ${RATE * 100}% 假設試算，你目前的準備金放到 ${retire} 歲，已經有機會達到目標。`;
        out('principal').textContent = wan(saved);
        out('growth').textContent = wan(target - saved);
      } else {
        const monthly = roundUp(m);
        const principal = monthly * years * 12 + saved;
        out('monthly').textContent = fmt(monthly);
        out('summary').textContent = `連續投入 ${years} 年，到 ${retire} 歲累積約 ${wan(target)}`;
        out('principal').textContent = wan(principal);
        out('growth').textContent = wan(Math.max(0, target - principal));
      }

      // 晚開始的代價
      const rows: string[] = [];
      const base = m;
      let note = '';
      const delays = [0, 3, 5, 10].filter((d) => years - d >= 1);
      const maxVal = Math.max(...delays.map((d) => need(age + d, retire, target, saved) ?? 0), 1);
      delays.forEach((d) => {
        const v = need(age + d, retire, target, saved) ?? 0;
        const pct = Math.max(4, (v / maxVal) * 100);
        const label = d === 0 ? '現在開始' : `晚 ${d} 年`;
        const diff = d === 0 || base === 0 ? '' : `<em>多 ${fmt(roundUp(v) - roundUp(base))} 元／月</em>`;
        rows.push(
          `<div class="dr${d === 0 ? ' now' : ''}"><span class="dl">${label}<small>${age + d} 歲</small></span><span class="db"><i style="width:${pct}%"></i></span><span class="dv">${fmt(roundUp(v))} 元${diff}</span></div>`,
        );
        if (d === 5 && base > 0) note = `只是晚 5 年，每月就要多存 ${fmt(roundUp(v) - roundUp(base))} 元，是現在的 ${(v / base).toFixed(1)} 倍。`;
      });
      out('delay').innerHTML = rows.join('');
      out('delaynote').textContent = note;

      // 通膨後的實際購買力
      const real = target / Math.pow(1 + INFL, years);
      out('inflation').innerHTML = `💡 提醒：若以每年通膨 ${INFL * 100}% 估算，${years} 年後的 ${wan(target)}，購買力約等於現在的 <strong>${wan(real)}</strong>。`;
    };

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', calc));
    calc();
  }
</script>

<style>
  .calc-page .eyebrow { color: var(--gold); font-weight: 700; font-size: 14px; letter-spacing: .1em; margin: 16px 0 0; }
  .calc { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 20px; margin: 8px 0 28px; }
  .calc-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .calc-fields label { min-width: 0; }
  .calc-fields label span { display: block; font-size: 14px; color: var(--ink-2); margin-bottom: 6px; }
  .field { display: flex; align-items: center; border: 1.5px solid var(--line); border-radius: 10px; background: var(--bg); padding: 0 12px; }
  .field:focus-within { border-color: var(--gold); }
  .field input { flex: 1; width: 100%; min-width: 0; border: 0; background: transparent; font-size: 20px; font-weight: 700; color: var(--ink); padding: 10px 0; outline: none; font-family: inherit; }
  .field em { font-style: normal; color: var(--muted); font-size: 15px; }
  .calc-result { margin: 20px 0 0; padding: 20px; border-radius: 14px; background: var(--ink); color: #f3eedf; text-align: center; }
  .res-label { margin: 0; color: var(--gold-soft); font-size: 14px; font-weight: 700; letter-spacing: .08em; }
  .res-main { margin: 4px 0; font-family: var(--serif); font-size: clamp(40px, 11vw, 56px); font-weight: 800; line-height: 1.2; color: #fff; }
  .res-main small { font-size: 18px; color: var(--gold-soft); }
  .res-sub { margin: 0 0 14px; font-size: 14px; color: #c9c3b3; }
  .res-split { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .res-split div { background: rgba(255,255,255,.07); border-radius: 10px; padding: 10px; }
  .res-split span { display: block; font-size: 13px; color: #c9c3b3; }
  .res-split strong { font-size: 18px; color: var(--gold-soft); }
  .delay { margin-top: 20px; }
  .delay-title { font-weight: 800; margin: 0 0 10px; }
  .delay-rows :global(.dr) { display: grid; grid-template-columns: 76px 1fr auto; align-items: center; gap: 10px; padding: 6px 0; font-size: 14px; }
  .delay-rows :global(.dl) { line-height: 1.3; }
  .delay-rows :global(.dl small) { display: block; color: var(--muted); font-size: 12px; }
  .delay-rows :global(.db) { height: 12px; background: var(--gold-bg); border-radius: 99px; overflow: hidden; }
  .delay-rows :global(.db i) { display: block; height: 100%; background: #c0392b; border-radius: 99px; opacity: .75; transition: width .3s; }
  .delay-rows :global(.now .db i) { background: var(--gold); opacity: 1; }
  .delay-rows :global(.dv) { text-align: right; font-weight: 700; line-height: 1.3; white-space: nowrap; }
  .delay-rows :global(.dv em) { display: block; font-style: normal; font-weight: 400; font-size: 12px; color: #c0392b; }
  .delay-note { margin: 10px 0 0; padding: 10px 14px; background: #fbeeea; border-radius: 10px; color: #8a2a1e; font-weight: 700; font-size: 15px; }
  .delay-note:empty { display: none; }
  .infl p { margin: 14px 0 0; padding: 10px 14px; background: var(--gold-bg); border-radius: 10px; font-size: 14px; color: var(--ink-2); }
  .assume { margin: 16px 0 0; font-size: 12px; color: var(--muted); line-height: 1.7; }
  @media (max-width: 480px) { .calc-fields { grid-template-columns: 1fr 1fr; gap: 10px; } .field input { font-size: 18px; } }
</style>
