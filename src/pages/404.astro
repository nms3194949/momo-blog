---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/posts';
---

<BaseLayout title="找不到頁面" description="這個頁面不存在或已移動。" noindex>
  <section class="wrap" style="text-align:center;padding:4rem 0">
    <h1 class="page-title">找不到這個頁面</h1>
    <p class="muted">文章可能已經改了網址。</p>
    <p><a class="btn btn-ghost" href={url('/')}>回到首頁</a></p>
  </section>
</BaseLayout>
