---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, collectTags, absUrl, postPath, tagPath, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...collectTags(posts).keys()].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${tag}｜文章列表`,
    url: absUrl(tagPath(tag)),
    hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: absUrl(postPath(p)) })),
  },
];
---

<BaseLayout title={`#${tag} 相關文章`} description={`MOMO 關於「${tag}」的所有文章，共 ${posts.length} 篇。`} jsonLd={jsonLd}>
  <section class="wrap">
    <h1 class="page-title">#{tag}</h1>
    <p class="muted">共 {posts.length} 篇文章</p>
    <div class="card-list">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</BaseLayout>
