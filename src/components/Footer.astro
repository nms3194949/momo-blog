---
import { SITE, LINKS, DISCLAIMER, withUtm } from '../site.config';
import { url } from '../lib/posts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="disclaimer"><strong>免責聲明｜</strong>{DISCLAIMER}</p>
    <div class="footer-row">
      <span>© {year} {SITE.name}</span>
      <nav class="footer-links">
        <a href={withUtm(LINKS.line, 'footer', 'footer')} target="_blank" rel="noopener">LINE</a>
        <a href={withUtm(LINKS.instagram, 'footer', 'footer')} target="_blank" rel="noopener">Instagram</a>
        <a href={LINKS.threads} target="_blank" rel="noopener">Threads</a>
        <a href={url('/rss.xml')}>RSS</a>
        <a href={url('/llms.txt')}>llms.txt</a>
      </nav>
    </div>
  </div>
</footer>
