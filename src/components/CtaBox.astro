---
// 文末導流區塊：LINE 為主、IG 為輔
import { LINKS, withUtm } from '../site.config';

interface Props {
  campaign: string;
  keyword?: string;
  igUrl?: string;
}
const { campaign, keyword = LINKS.lineKeyword, igUrl } = Astro.props;
---

<aside class="cta-box">
  <p class="cta-eyebrow">想拿完整版？</p>
  <p class="cta-title">加入官方 LINE，輸入「{keyword}」</p>
  <p class="cta-text">
    市場出現重要變化時，我會在 LINE 第一時間整理重點給你；這篇提到的完整清單與配置範例，也會在 LINE 提供。
  </p>
  <div class="cta-actions">
    <a class="btn btn-line" href={withUtm(LINKS.line, campaign, 'article-end')} target="_blank" rel="noopener">
      加入官方 LINE
    </a>
    {
      igUrl ? (
        <a class="btn btn-ghost" href={withUtm(igUrl, campaign, 'article-end')} target="_blank" rel="noopener">
          看 IG 輪播版
        </a>
      ) : (
        <a class="btn btn-ghost" href={withUtm(LINKS.instagram, campaign, 'article-end')} target="_blank" rel="noopener">
          追蹤 IG
        </a>
      )
    }
  </div>
</aside>
